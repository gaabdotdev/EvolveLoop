{
  "name": "@agents/orchestrator",
  "version": "2.0.0",
  "description": "EvolveLoop orchestrator — Execution Engine based on Capability IR",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "pretest": "bash ../scripts/ensure-baseline-tokenizer.sh",
    "test": "vitest run",
    "test:bench": "vitest run --config vitest.bench.config.ts",
    "test:v0-offline": "vitest run --config vitest.v0-offline.config.ts",
    "test:v0-live": "bash ../scripts/v0-live-five-tasks.sh",
    "test:v1-gate-prod": "vitest run --config vitest.v1-gate-prod.config.ts",
    "test:v1-gate-compat": "bash ../scripts/v1-gate-compat.sh",
    "test:v1-gate-tok": "bash ../scripts/v1-gate-tok.sh",
    "test:watch": "vitest",
    "test:unit": "bash ../scripts/ensure-baseline-tokenizer.sh && vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:evals": "vitest run tests/evals",
    "run-engine": "node dist/cli/run-engine.js",
    "registry-builder": "node dist/cli/registry-builder.js",
    "registry-builder:ci": "bash scripts/registry-builder-ci.sh",
    "run-jobs": "node dist/cli/run-jobs.js",
    "evolve": "node dist/cli/evolve.js"
  },
  "bin": {
    "run-engine": "./dist/cli/run-engine.js",
    "registry-builder": "./dist/cli/registry-builder.js",
    "run-jobs": "./dist/cli/run-jobs.js",
    "evolve": "./dist/cli/evolve.js"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.31",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "yaml": "^2.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "@mongodb-js/zstd": "^7.0.0",
    "better-sqlite3": "^13.2.0",
    "ink": "^5.2.1",
    "react": "^18.3.1",
    "sqlite-vec": "^0.1.9",
    "tree-sitter-javascript": "^0.23.1",
    "tree-sitter-typescript": "^0.23.2",
    "web-tree-sitter": "^0.27.2"
  }
}
