+
+
+def test_reset_for_tests_clears_buckets():
+    from api.rate_limit import allow_request, reset_for_tests
+
+    key = "test:unit:reset"
+    assert allow_request(key, limit=1, window_sec=60.0) is True
+    assert allow_request(key, limit=1, window_sec=60.0) is False
+    reset_for_tests()
+    assert allow_request(key, limit=1, window_sec=60.0) is True
+
+
+def test_allow_request_limit_one():
+    from api.rate_limit import allow_request, reset_for_tests
+
+    reset_for_tests()
+    key = "test:unit:limit1"
+    assert allow_request(key, limit=1, window_sec=60.0) is True
+    assert allow_request(key, limit=1, window_sec=60.0) is False
